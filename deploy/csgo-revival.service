# systemd unit for the CS:GO Revival inventory server.
#
# Install (on the Oracle VM):
#   sudo cp deploy/csgo-revival.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now csgo-revival
#
# Adjust User/WorkingDirectory/ExecStart below if you cloned somewhere other
# than /home/ubuntu/kinkerm-csgo-revival.

[Unit]
Description=CS:GO Revival inventory + admin server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/kinkerm-csgo-revival/server
ExecStart=/usr/bin/python3 /home/ubuntu/kinkerm-csgo-revival/server/revival_server.py --host 0.0.0.0 --port 8787
Restart=on-failure
RestartSec=3

# Light hardening (safe defaults; loosen if you relocate data elsewhere)
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
